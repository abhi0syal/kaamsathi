# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Security & Privacy
USER_HASH_SALT=your_random_secret_salt_for_hashing_user_ids

# Testing / Sandbox (Optional)
SANDBOX_MODE=false
ALLOWED_TEST_NUMBERS=919876543210,918888888888
